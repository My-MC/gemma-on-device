{
  "name": "gemma-on-device",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "bun run licenses:generate",
    "dev": "vite",
    "prebuild": "bun run licenses:generate",
    "build": "tsc && vite build",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check --write . --error-on-warnings",
    "check:ci": "biome ci . --error-on-warnings",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:cuda": "bun scripts/build_tauri_edition.ts cuda",
    "tauri:migraphx": "bun scripts/build_tauri_edition.ts migraphx",
    "tauri:coreml": "bun scripts/build_tauri_edition.ts coreml",
    "download:model": "bun scripts/download_model.ts",
    "download:model:1b": "bun scripts/download_model.ts --variant 1b-int4",
    "download:model:3n": "bun scripts/download_model.ts --variant 3n-e2b-int4",
    "download:ort-dll": "bun scripts/download_ort_dll.ts",
    "export:onnx": "python3 scripts/export_onnx.py",
    "bench": "bun scripts/bench.ts",
    "check:ort": "bun scripts/check_ort.ts",
    "licenses:generate": "bun scripts/generate_licenses.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "license-checker": "^25.0.1",
    "spdx-license-list": "^6.12.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
