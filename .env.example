# Gemma On Device — Environment Variables
# Copy this file to .env and adjust as needed.
# .env is gitignored and NOT required for normal development.

# Vite dev server port (default: 1420)
# Used by: vite.config.ts → server.port
VITE_PORT=1420

# Vite HMR WebSocket port (default: 1421)
# Only used when TAURI_DEV_HOST is set (Tauri dev mode).
# Used by: vite.config.ts → server.hmr.port
VITE_HMR_PORT=1421

# Vite preview server port (default: 1420)
# Used by: vite.config.ts → preview.port
VITE_PREVIEW_PORT=1420

# Tauri dev host — set to your machine's IP for mobile dev.
# When set, Vite binds to this host and enables HMR over WebSocket.
# Example: TAURI_DEV_HOST=192.168.1.100
# Used by: vite.config.ts → server.host + server.hmr.host
TAURI_DEV_HOST=
